{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|mcp__.*[Gg]it[Hh]ub.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/tools/review_gate/review_gate.py\" hook",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": ["Edit(**/.git/dvb-review/**)"]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
